# GEAR GUARD GARY — backend settings. Every one of these has a working
# default; copy to .env only to override. None of them is a credential.

# The token. Leave TOKEN_CONTRACT blank until the mint exists — blank makes the
# page say CONTRACT NOT SET instead of inventing a price.
TOKEN_NAME=Gear Guard Gary
TOKEN_SYMBOL=RIVN
TOKEN_CHAIN=solana
TOKEN_CONTRACT=

# A pool shallower than this is not quoted (it is noise, not a market).
MIN_LIQUIDITY_USD=5000

# Context markets shown behind the token (Pyth Hermes, keyless).
MAJORS=SOL/USD,ETH/USD,BTC/USD

CACHE_TTL_SECONDS=30
CORS_ORIGINS=*
